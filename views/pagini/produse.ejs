<!DOCTYPE html>
<html lang="ro">

<head>
    <meta name="keywords" content="instrumente muzicale, magazin muzica, 
                            chitara, pian, tobe, instrumente de suflat">
    <meta name="description"
        content="Magazin online specializat în instrumente muzicale pentru muzicieni amatori și profesioniști.">
    <link rel="stylesheet" href="/resurse/css/produse.css" type="text/css" />
    <title>Magazin online de instrumente muzicale: SoundMaster</title>
    <%- include("../fragmente/head") %>
        <script type="text/javascript" src=/resurse/js/produse.js></script>
        <script type="text/javascript" src=/resurse/js/produse-cos.js></script>

</head>

<body>


    <%- include("../fragmente/header") %>

        <main>
            <!-- Bonus 1 -->
            <% let preturi=locals.produse.map(p=> p.pret);
                let minPret = Math.min(...preturi);
                let maxPret = Math.max(...preturi);
                %>

                <% let lungimi=locals.produse.map(p=> p.descriere.length);
                    let minLen = Math.min(...lungimi);
                    let maxLen = Math.max(...lungimi);
                    %>
                    <% let materiale=new Set(); locals.produse.forEach(p=> {
                        p.materiale.forEach(m => materiale.add(m));
                        });
                        %>
                        <% let areElectric=locals.produse.some(p=> p.este_electric);
                            %>
                            <% let materiale2=new Set(); locals.produse.forEach(p=> {
                                (p.materiale || []).forEach(m => materiale2.add(m));
                                });

                                materiale2 = [...materiale2];
                                %>

                                <section id="filtre" class="container">
                                    <h2>Filtrează Instrumente</h2>

                                    <div class="row g-3"></div>

                                    <div class="col-12 col-md-6 col-lg-4">
                                        <label class="form-label">Nume</label>
                                        <input type="text" id="inp-nume" class="form-control">
                                    </div>

                                    <div class="col-12 col-md-6 col-lg-4">
                                        <label class="form-label">Material</label>
                                        <input list="lista-materiale" id="inp-material">
                                        <datalist id="lista-materiale">
                                            <% for (let m of materiale) { %>
                                                <option value="<%- m %>">
                                                    <% } %>
                                        </datalist>
                                        </label>

                                    </div>

                                    <div class="col-12 col-md-6 col-lg-4">
                                        <label class="form-label">Preț minim</label>
                                        <span id="val-pret-min">(<%- minPret %>)</span>
                                        <input type="range" id="inp-pret-min" class="form-range" min="<%- minPret %>"
                                            max="<%- maxPret %>" value="<%- minPret %>">
                                    </div>

                                    <div class="col-12 col-md-6 col-lg-4">
                                        <label class="form-label">Preț maxim</label>
                                        <span id="val-pret-max">(<%- maxPret %>)</span>
                                        <input type="range" id="inp-pret-max" class="form-range" min="<%- minPret %>"
                                            max="<%- maxPret %>" value="<%- maxPret %>">
                                    </div>

                                    <div class="col-12">
                                        <label class="form-label d-block">Tip instrument</label>

                                        <input type="radio" class="btn-check" name="gr_rad" id="rad-toate" value="toate"
                                            checked>
                                        <label class="btn btn-outline-primary" for="rad-toate">Toate</label>

                                        <input type="radio" class="btn-check" name="gr_rad" id="rad-piane"
                                            value="piane">
                                        <label class="btn btn-outline-primary" for="rad-piane">Piane</label>

                                        <input type="radio" class="btn-check" name="gr_rad" id="rad-chitare"
                                            value="chitare_si_basuri">
                                        <label class="btn btn-outline-primary" for="rad-chitare">Chitare și
                                            basuri</label>

                                        <input type="radio" class="btn-check" name="gr_rad" id="rad-tobe" value="tobe">
                                        <label class="btn btn-outline-primary" for="rad-tobe">Tobe</label>

                                        <input type="radio" class="btn-check" name="gr_rad" id="rad-coarde"
                                            value="instrumente_cu_coarde">
                                        <label class="btn btn-outline-primary" for="rad-coarde">Coarde</label>
                                    </div>

                                    <div class="col-6 col-md-3">
                                        <label class="form-label">Lungime min</label>
                                        <input type="number" id="inp-len-min" class="form-control" min="<%- minLen %>"
                                            max="<%- maxLen %>" value="<%- minLen %>">
                                    </div>

                                    <div class="col-6 col-md-3">
                                        <label class="form-label">Lungime max</label>
                                        <input type="number" id="inp-len-max" class="form-control" min="<%- minLen %>"
                                            max="<%- maxLen %>" value="<%- maxLen %>">
                                    </div>

                                    <div class="col-12">
                                        <div class="form-floating">
                                            <textarea id="inp-descriere" class="form-control"></textarea>
                                            <label for="inp-descriere">Descriere conține</label>
                                        </div>
                                    </div>


                                    <div class="col-12 col-md-6">
                                        <label class="form-label">Categorie utilizare</label>
                                        <select id="inp-categorie" class="form-select">
                                            <option value="toate">oricare</option>
                                            <option value="incepator">începător</option>
                                            <option value="intermediar">intermediar</option>
                                            <option value="profesionist">profesionist</option>
                                            <option value="copii">copii</option>
                                        </select>
                                    </div>

                                    <div class="col-12 col-md-6">
                                        <label class="form-label">Materiale</label>
                                        <select id="inp-materiale" class="form-select" multiple>
                                            <% for (let m of materiale2) { %>
                                                <option value="<%- m %>"><%- m %></option>
                                                <% } %>
                                        </select>
                                    </div>

                                    <div class="col-12">
                                        <input type="checkbox" id="inp-electric" class="form-check-input" <%-
                                            areElectric ? '' : 'disabled' %>>
                                        <label for="inp-electric">Doar electrice</label>
                                    </div>
                                    <label>
                                        <input type="checkbox" id="salveaza-filtrare">
                                        Salvează filtrarea
                                    </label>

                                    <div class="col-12">
                                        <button id="filtrare" class="btn btn-primary">
                                            <i class="bi bi-funnel"></i>
                                            <span class="d-none d-md-inline">Filtrează</span>
                                        </button>
                                        <button id="resetare" class="btn btn-primary">
                                            <i class="bi bi-arrow-clockwise"></i>
                                            <span class="d-none d-md-inline">Resetează</span>
                                        </button>

                                        <button id="sortCrescNume" class="btn btn-primary">
                                            <i class="bi bi-sort-alpha-down"></i>
                                            <span class="d-none d-md-inline">Crescător</span>
                                        </button>

                                        <button id="sortDescrescNume" class="btn btn-primary">
                                            <i class="bi bi-sort-alpha-up"></i>
                                            <span class="d-none d-md-inline">Descrescător</span>
                                        </button>

                                        <button id="calculeaza-suma" class="btn btn-danger">
                                            <i class="bi bi-calculator"></i>
                                            <span class="d-none d-md-inline">Sumă</span>
                                        </button>
                                        <!-- Sortare avansată (Bonus 8) -->
                                        <button id="sortare-avansata" class="btn btn-warning">
                                            Sortare avansată
                                        </button>
                                        <div class="row">
                                            <div class="col-12 col-md-6">
                                                <label>Sortare 1</label>
                                                <select id="sort-key-1" class="form-select">
                                                    <option value="nume">Nume</option>
                                                    <option value="pret">Preț</option>
                                                    <option value="categorie">Categorie</option>
                                                </select>
                                            </div>

                                            <div class="col-12 col-md-6">
                                                <label>Direcție 1</label>
                                                <select id="sort-dir-1" class="form-select">
                                                    <option value="1">Crescător</option>
                                                    <option value="-1">Descrescător</option>
                                                </select>
                                            </div>

                                            <div class="col-12 col-md-6">
                                                <label>Sortare 2</label>
                                                <select id="sort-key-2" class="form-select">
                                                    <option value="nume">Nume</option>
                                                    <option value="pret">Preț</option>
                                                    <option value="categorie">Categorie</option>
                                                </select>
                                            </div>

                                            <div class="col-12 col-md-6">
                                                <label>Direcție 2</label>
                                                <select id="sort-dir-2" class="form-select">
                                                    <option value="1">Crescător</option>
                                                    <option value="-1">Descrescător</option>
                                                </select>
                                            </div>
                                        </div>

                                    </div>

                                </section>

                                <section id="produse">

                                    <h2>Instrumente</h2>
                                    <p id="nr-produse" style="font-weight:bold;"></p>

                                    <div class="grid-produse">

                                        <% for (let prod of locals.produse) { %>
                                            <article class="produs">

                                                <h3 class="nume">

                                                    Nume:
                                                    <a href="/produs/<%- prod.id %>">
                                                        <span class="val-nume"><%- prod.nume %></span>
                                                    </a>
                                                </h3>

                                                <div class="info-prod">

                                                    <p class="pret">
                                                        Preț: <span class="val-pret"><%- prod.pret %></span>
                                                    </p>

                                                    <p class="materiale" style="display: none">
                                                        Materiale: <span class="val-materiale"><%- prod.materiale %>
                                                        </span>
                                                    </p>

                                                    <p class="electric" style="display: none">
                                                        Electric: <span class="val-electric"><%- prod.este_electric %>
                                                        </span>
                                                    </p>

                                                    <p class="utilizare" style="display: none">
                                                        Utilizare: <span class="val-categorie"><%- prod.categorie %>
                                                        </span>
                                                    </p>
                                                    <p class="badge-ieftin"
                                                        style="display:none; font-weight:bold; color:white; background:red; padding:5px; width:fit-content;">
                                                        Cel mai ieftin din categorie
                                                    </p> <!--Bonus 14-->


                                                    <p class="tip_produs">
                                                        Tip instrument:
                                                        <span class="val-tip"><%-
                                                                prod.tip_produs.toLowerCase().replace(/\s+/g, '_' )
                                                                %></span>
                                                    </p>

                                                </div>

                                                <span class="val-descriere"><%- prod.descriere %> </span>

                                                <figure>
                                                    <a href="/produs/<%- prod.id %>">
                                                        <img src="/resurse/imagini/produse/<%- prod.imagine %>"
                                                            style="width:50%;height:auto;"
                                                            alt="[imagine <%- prod.nume %>]" />
                                                    </a>
                                                </figure>


                                                <label class="selecteaza-cos">
                                                    Selectează:<br />
                                                    <input type="checkbox" class="select-cos" value="<%- prod.id %>"
                                                        autocomplete="off">
                                                </label>

                                            </article>
                                            <% } %>

                                    </div>

                                </section>

        </main>

        <%- include("../fragmente/footer") %>
</body>

</html>