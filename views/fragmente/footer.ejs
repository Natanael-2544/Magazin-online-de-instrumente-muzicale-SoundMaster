<script>
    async function incarcaProduse() {
        const res = await fetch("/api/carousel-produse");
        const produse = await res.json();

        const inner = document.getElementById("carousel-inner");
        const indicators = document.getElementById("indicators");

        inner.innerHTML = "";
        indicators.innerHTML = "";

        produse.forEach((p, i) => {

            const active = i === 0 ? "active" : "";

            inner.innerHTML += `
<div class="carousel-item ${active}">
    <img src="${p.imagine}" class="d-block">

    <div class="carousel-caption bg-dark bg-opacity-50 rounded">
        <h5>${p.nume}</h5>
        <p>${p.descriere ?? ""}</p>
        <p><b>${p.pret ?? ""} RON</b></p>
    </div>
</div>
`;

            indicators.innerHTML += `
        <button type="button"
            data-bs-target="#caruselProduse"
            data-bs-slide-to="${i}"
            class="${active}"
            aria-current="true"></button>
        `;
        });
    }

    
    incarcaProduse();


    setInterval(incarcaProduse, 15000);
</script>
<script>
window.addEventListener("load", function () {

    let ultimaPagina = getCookie("ultima_pagina");

    let el = document.getElementById("info-cookie");

    if (el) {
        el.innerHTML = `
            <strong>Informații utilizator:</strong><br>
            Ultima pagină accesată: ${ultimaPagina ?? "N/A"}
        `;
    }

});
</script>